Options -Indexes
RewriteEngine On

# Application code, configuration and data are never served directly.
RewriteRule ^(config|core|controllers|services|models|views|database|tests|vendor|docs)(/|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "\.(md|json|xml|lock|sql|log)$">
    Require all denied
</FilesMatch>
